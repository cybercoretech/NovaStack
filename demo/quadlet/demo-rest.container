[Unit]
Description=NovaStack demo: REST API (Postgres, auth, metrics) at rest-demo.cybercoretech.net
Requires=demo-postgres.service
After=demo-postgres.service

[Container]
ContainerName=demo-rest
Image=ghcr.io/cybercoretech/novastack-demo-rest:latest
# podman-auto-update.timer pulls a newer :latest (published on each release)
AutoUpdate=registry
Network=novastack-demo.network
Network=novastack-demo-db.network
# Written by demo/install.sh (database URL, JWT secret); never committed
EnvironmentFile=%h/.config/novastack-demo/rest.env
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=128m --cpus=0.5 --pids-limit=256
HealthCmd=curl -fsS http://localhost:8080/health
HealthInterval=15s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=default.target
