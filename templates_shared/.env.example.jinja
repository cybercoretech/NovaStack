# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,tower_http=debug,sqlx=warn
{% if db == "postgres" %}

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ project_name_snake }}
DATABASE_MAX_CONNECTIONS=20
{% elif db == "sqlite" %}

# Database Configuration (SQLite; mode=rwc creates the file on first run)
DATABASE_URL=sqlite://{{ project_name_snake }}.db?mode=rwc
DATABASE_MAX_CONNECTIONS=5
{% endif %}

