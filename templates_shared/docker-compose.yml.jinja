services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "8080:8080"
    # Secrets and settings from .env (cp .env.example .env); the values below override
    # it with in-container addresses.
    env_file:
      - path: .env
        required: false
    environment:
      - HOST=0.0.0.0
      - PORT=8080
      - RUST_LOG=info,tower_http=debug
      {% if db == "postgres" %}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/{{ project_name_snake }}
      {% elif db == "sqlite" %}
      - DATABASE_URL=sqlite:///app/data/{{ project_name_snake }}.db?mode=rwc
      {% endif %}
      {% if has_redis %}
      - REDIS_URL=redis://redis:6379
      {% endif %}
    {% if db == "sqlite" %}
    volumes:
      - appdata:/app/data
    {% endif %}
    {% if db == "postgres" or has_redis %}
    depends_on:
      {% if db == "postgres" %}
      db:
        condition: service_healthy
      {% endif %}
      {% if has_redis %}
      redis:
        condition: service_started
      {% endif %}
    {% endif %}

{% if db == "postgres" %}
  db:
    image: postgres:16-alpine
    restart: always
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ project_name_snake }}
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ project_name_snake }}"]
      interval: 5s
      timeout: 5s
      retries: 5
{% endif %}

{% if has_redis %}
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redisdata:/data
{% endif %}

{% if db != "none" or has_redis %}
volumes:
{% if db == "postgres" %}
  pgdata:
{% elif db == "sqlite" %}
  appdata:
{% endif %}
{% if has_redis %}
  redisdata:
{% endif %}
{% endif %}
