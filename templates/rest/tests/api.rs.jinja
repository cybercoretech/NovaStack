use axum::{
    body::Body,
    http::{header, Method, Request, StatusCode},
    Router,
};
use http_body_util::BodyExt;
use serde_json::{json, Value};
use tower::ServiceExt;
use {{ project_name_snake }}::api::{self, items::ItemStore};

{% if db == "sqlite" %}
/// A fresh in-memory SQLite database with the project's migrations applied.
async fn app() -> Option<Router> {
    let pool = sqlx::sqlite::SqlitePoolOptions::new()
        .max_connections(1)
        .connect("sqlite::memory:")
        .await
        .unwrap();
    sqlx::migrate!("./src/db/migrations").run(&pool).await.unwrap();
    Some(api::routes(ItemStore::new(pool)))
}
{% elif db == "postgres" %}
/// Runs against the database in `DATABASE_URL` (e.g. `docker compose up -d db`); the tests
/// are skipped when it isn't set.
async fn app() -> Option<Router> {
    let Ok(url) = std::env::var("DATABASE_URL") else {
        eprintln!("skipping: set DATABASE_URL to run the database-backed API tests");
        return None;
    };
    let pool = sqlx::PgPool::connect(&url).await.unwrap();
    sqlx::migrate!("./src/db/migrations").run(&pool).await.unwrap();
    Some(api::routes(ItemStore::new(pool)))
}
{% else %}
async fn app() -> Option<Router> {
    Some(api::routes(ItemStore::default()))
}
{% endif %}

/// Routes whose handlers never touch the database (e.g. the OpenAPI spec).
fn app_without_db() -> Router {
{% if db == "postgres" %}
    let pool = sqlx::postgres::PgPoolOptions::new()
        .connect_lazy("postgres://localhost/unused")
        .unwrap();
    api::routes(ItemStore::new(pool))
{% elif db == "sqlite" %}
    let pool = sqlx::sqlite::SqlitePoolOptions::new()
        .connect_lazy("sqlite::memory:")
        .unwrap();
    api::routes(ItemStore::new(pool))
{% else %}
    api::routes(ItemStore::default())
{% endif %}
}

async fn call(app: &Router, method: Method, uri: &str, body: Option<Value>) -> (StatusCode, Value) {
    let mut request = Request::builder().method(method).uri(uri);
    let body = match body {
        Some(json) => {
            request = request.header(header::CONTENT_TYPE, "application/json");
            Body::from(json.to_string())
        }
        None => Body::empty(),
    };
    let response = app
        .clone()
        .oneshot(request.body(body).unwrap())
        .await
        .unwrap();
    let status = response.status();
    let bytes = response.into_body().collect().await.unwrap().to_bytes();
    let value = serde_json::from_slice(&bytes).unwrap_or(Value::Null);
    (status, value)
}

#[tokio::test]
async fn items_crud_round_trip() {
    let Some(app) = app().await else { return };

    let (status, created) = call(&app, Method::POST, "/api/items", Some(json!({"name": "Widget"}))).await;
    assert_eq!(status, StatusCode::CREATED);
    let id = created["id"].as_u64().unwrap();

    let (status, list) = call(&app, Method::GET, "/api/items", None).await;
    assert_eq!(status, StatusCode::OK);
    assert!(list.as_array().unwrap().iter().any(|item| item["id"] == created["id"]));

    let uri = format!("/api/items/{id}");
    let (status, fetched) = call(&app, Method::GET, &uri, None).await;
    assert_eq!(status, StatusCode::OK);
    assert_eq!(fetched["name"], "Widget");

    let (status, updated) = call(&app, Method::PUT, &uri, Some(json!({"name": "Gadget"}))).await;
    assert_eq!(status, StatusCode::OK);
    assert_eq!(updated["name"], "Gadget");

    let (status, _) = call(&app, Method::DELETE, &uri, None).await;
    assert_eq!(status, StatusCode::NO_CONTENT);
    let (status, _) = call(&app, Method::DELETE, &uri, None).await;
    assert_eq!(status, StatusCode::NOT_FOUND);
    let (status, _) = call(&app, Method::GET, &uri, None).await;
    assert_eq!(status, StatusCode::NOT_FOUND);
}

#[tokio::test]
async fn rejects_blank_names() {
    // Validation fails before any query runs.
    let app = app_without_db();
    let (status, _) = call(&app, Method::POST, "/api/items", Some(json!({"name": "  "}))).await;
    assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
}

#[tokio::test]
async fn serves_openapi_spec() {
    let app = app_without_db();
    let (status, spec) = call(&app, Method::GET, "/api-docs/openapi.json", None).await;
    assert_eq!(status, StatusCode::OK);
    assert!(spec["paths"]["/api/items/{id}"].is_object());
}
