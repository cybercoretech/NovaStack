//! Example CRUD resource.
//!
{% if db == "none" %}
//! This project has no database, so items live in memory (`ItemStore`) and reset on restart.
//! Generate a project with `--db postgres` or `--db sqlite` to get the SQLx version.
{% else %}
//! Items are stored in the `items` table (`src/db/migrations`) through `ItemStore`, which
//! wraps the SQLx pool from `AppState::db`. Copy this pattern for your own resources.
{% endif %}

use crate::error::AppError;
use crate::state::AppState;
use axum::{
    extract::{Path, State},
    http::StatusCode,
    routing::get,
    Json, Router,
};
use serde::{Deserialize, Serialize};
{% if db == "none" %}
use std::collections::BTreeMap;
use std::sync::Arc;
use tokio::sync::RwLock;
{% endif %}
use utoipa::ToSchema;

const MAX_NAME_LEN: usize = 200;

{% if db == "none" %}
#[derive(Debug, Clone, Serialize, ToSchema)]
{% else %}
#[derive(Debug, Clone, Serialize, ToSchema, sqlx::FromRow)]
{% endif %}
pub struct Item {
    pub id: i64,
    pub name: String,
    pub description: Option<String>,
}

#[derive(Debug, Deserialize, ToSchema)]
pub struct NewItem {
    pub name: String,
    pub description: Option<String>,
}

{% if db == "none" %}
#[derive(Default)]
struct Store {
    next_id: i64,
    items: BTreeMap<i64, Item>,
}

/// In-memory item storage (this project has no database).
#[derive(Clone, Default)]
pub struct ItemStore {
    inner: Arc<RwLock<Store>>,
}

impl ItemStore {
    /// Builds the store used by the running app.
    pub fn from_state(_state: &AppState) -> Self {
        Self::default()
    }

    pub async fn list(&self) -> Result<Vec<Item>, AppError> {
        Ok(self.inner.read().await.items.values().cloned().collect())
    }

    pub async fn create(&self, name: &str, description: Option<String>) -> Result<Item, AppError> {
        let mut store = self.inner.write().await;
        store.next_id += 1;
        let item = Item {
            id: store.next_id,
            name: name.to_string(),
            description,
        };
        store.items.insert(item.id, item.clone());
        Ok(item)
    }

    pub async fn get(&self, id: i64) -> Result<Option<Item>, AppError> {
        Ok(self.inner.read().await.items.get(&id).cloned())
    }

    pub async fn update(
        &self,
        id: i64,
        name: &str,
        description: Option<String>,
    ) -> Result<Option<Item>, AppError> {
        let mut store = self.inner.write().await;
        Ok(store.items.get_mut(&id).map(|item| {
            item.name = name.to_string();
            item.description = description;
            item.clone()
        }))
    }

    /// Returns `false` when there was no such item.
    pub async fn delete(&self, id: i64) -> Result<bool, AppError> {
        Ok(self.inner.write().await.items.remove(&id).is_some())
    }
}
{% else %}
{% if db == "postgres" %}
type Pool = sqlx::PgPool;
{% else %}
type Pool = sqlx::SqlitePool;
{% endif %}

/// Item storage backed by the `items` table.
#[derive(Clone)]
pub struct ItemStore {
    db: Pool,
}

impl ItemStore {
    pub fn new(db: Pool) -> Self {
        Self { db }
    }

    /// Builds the store used by the running app from its shared database pool.
    pub fn from_state(state: &AppState) -> Self {
        Self::new(state.db.clone())
    }

    pub async fn list(&self) -> Result<Vec<Item>, AppError> {
        let items = sqlx::query_as::<_, Item>("SELECT id, name, description FROM items ORDER BY id")
            .fetch_all(&self.db)
            .await?;
        Ok(items)
    }

    pub async fn create(&self, name: &str, description: Option<String>) -> Result<Item, AppError> {
        let item = sqlx::query_as::<_, Item>(
            "INSERT INTO items (name, description) VALUES ($1, $2) RETURNING id, name, description",
        )
        .bind(name)
        .bind(description)
        .fetch_one(&self.db)
        .await?;
        Ok(item)
    }

    pub async fn get(&self, id: i64) -> Result<Option<Item>, AppError> {
        let item = sqlx::query_as::<_, Item>("SELECT id, name, description FROM items WHERE id = $1")
            .bind(id)
            .fetch_optional(&self.db)
            .await?;
        Ok(item)
    }

    pub async fn update(
        &self,
        id: i64,
        name: &str,
        description: Option<String>,
    ) -> Result<Option<Item>, AppError> {
        let item = sqlx::query_as::<_, Item>(
            "UPDATE items SET name = $1, description = $2 WHERE id = $3 RETURNING id, name, description",
        )
        .bind(name)
        .bind(description)
        .bind(id)
        .fetch_optional(&self.db)
        .await?;
        Ok(item)
    }

    /// Returns `false` when there was no such item.
    pub async fn delete(&self, id: i64) -> Result<bool, AppError> {
        let result = sqlx::query("DELETE FROM items WHERE id = $1")
            .bind(id)
            .execute(&self.db)
            .await?;
        Ok(result.rows_affected() > 0)
    }
}
{% endif %}

pub fn router<S>(store: ItemStore) -> Router<S>
where
    S: Clone + Send + Sync + 'static,
{
    Router::new()
        .route("/", get(list_items).post(create_item))
        .route("/{id}", get(get_item).put(update_item).delete(delete_item))
        .with_state(store)
}

fn validate(input: &NewItem) -> Result<(), AppError> {
    let name = input.name.trim();
    if name.is_empty() {
        return Err(AppError::Validation("name must not be empty".into()));
    }
    if name.chars().count() > MAX_NAME_LEN {
        return Err(AppError::Validation(format!(
            "name must be at most {MAX_NAME_LEN} characters"
        )));
    }
    Ok(())
}

/// List all items.
#[utoipa::path(
    get,
    path = "/api/items",
    tag = "items",
    responses((status = 200, description = "All items", body = [Item]))
)]
pub async fn list_items(State(store): State<ItemStore>) -> Result<Json<Vec<Item>>, AppError> {
    Ok(Json(store.list().await?))
}

/// Create an item.
#[utoipa::path(
    post,
    path = "/api/items",
    tag = "items",
    request_body = NewItem,
    responses(
        (status = 201, description = "Item created", body = Item),
        (status = 422, description = "Invalid input")
    )
)]
pub async fn create_item(
    State(store): State<ItemStore>,
    Json(input): Json<NewItem>,
) -> Result<(StatusCode, Json<Item>), AppError> {
    validate(&input)?;
    let item = store.create(input.name.trim(), input.description).await?;
    Ok((StatusCode::CREATED, Json(item)))
}

/// Fetch one item.
#[utoipa::path(
    get,
    path = "/api/items/{id}",
    tag = "items",
    params(("id" = i64, Path, description = "Item id")),
    responses(
        (status = 200, description = "The item", body = Item),
        (status = 404, description = "No such item")
    )
)]
pub async fn get_item(
    State(store): State<ItemStore>,
    Path(id): Path<i64>,
) -> Result<Json<Item>, AppError> {
    store.get(id).await?.map(Json).ok_or(AppError::NotFound)
}

/// Replace an item.
#[utoipa::path(
    put,
    path = "/api/items/{id}",
    tag = "items",
    params(("id" = i64, Path, description = "Item id")),
    request_body = NewItem,
    responses(
        (status = 200, description = "Item updated", body = Item),
        (status = 404, description = "No such item"),
        (status = 422, description = "Invalid input")
    )
)]
pub async fn update_item(
    State(store): State<ItemStore>,
    Path(id): Path<i64>,
    Json(input): Json<NewItem>,
) -> Result<Json<Item>, AppError> {
    validate(&input)?;
    store
        .update(id, input.name.trim(), input.description)
        .await?
        .map(Json)
        .ok_or(AppError::NotFound)
}

/// Delete an item.
#[utoipa::path(
    delete,
    path = "/api/items/{id}",
    tag = "items",
    params(("id" = i64, Path, description = "Item id")),
    responses(
        (status = 204, description = "Item deleted"),
        (status = 404, description = "No such item")
    )
)]
pub async fn delete_item(
    State(store): State<ItemStore>,
    Path(id): Path<i64>,
) -> Result<StatusCode, AppError> {
    if store.delete(id).await? {
        Ok(StatusCode::NO_CONTENT)
    } else {
        Err(AppError::NotFound)
    }
}
