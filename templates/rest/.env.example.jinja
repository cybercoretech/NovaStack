# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,tower_http=debug,sqlx=warn

{% if db == "postgres" %}
# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ project_name_snake }}
DATABASE_MAX_CONNECTIONS=20
{% elif db == "sqlite" %}
# Database Configuration (SQLite)
DATABASE_URL=sqlite://{{ project_name_snake }}.db
DATABASE_MAX_CONNECTIONS=5
{% endif %}

{% if has_auth %}
# JWT Authentication Secret
JWT_SECRET=super-secret-jwt-key-replace-in-production-change-me
JWT_EXPIRATION_HOURS=24
{% endif %}

{% if has_redis %}
# Redis Configuration
REDIS_URL=redis://localhost:6379
{% endif %}
