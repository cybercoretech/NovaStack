use {{ project_name_snake }}::grpc::proto::greeter_client::GreeterClient;
use {{ project_name_snake }}::grpc::proto::HelloRequest;

/// Serves the gRPC routes on an ephemeral port and returns its address.
async fn spawn_server() -> std::net::SocketAddr {
    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
    let addr = listener.local_addr().unwrap();
    let app: axum::Router = {{ project_name_snake }}::grpc::routes();
    tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
    addr
}

#[tokio::test]
async fn say_hello_over_the_network() {
    let addr = spawn_server().await;
    let mut client = GreeterClient::connect(format!("http://{addr}")).await.unwrap();

    let reply = client
        .say_hello(HelloRequest { name: "NovaStack".into() })
        .await
        .unwrap()
        .into_inner();
    assert_eq!(reply.message, "Hello, NovaStack!");

    let status = client
        .say_hello(HelloRequest { name: "  ".into() })
        .await
        .unwrap_err();
    assert_eq!(status.code(), tonic::Code::InvalidArgument);
}
