# Cloudflare Pages response headers
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cybercoretech.github.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cybercoretech.github.io; font-src https://fonts.gstatic.com; img-src 'self' data: https://github.com https://cybercoretech.github.io; connect-src 'self' https://cybercoretech.github.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/data/*
  Cache-Control: public, max-age=300

/assets/*
  Cache-Control: public, max-age=86400
